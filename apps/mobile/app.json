{
  "expo": {
    "name": "Flownd",
    "slug": "flownd",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/brand/icon.png",
    "scheme": "flownd",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": {
        "light": "./assets/images/brand/icon.png",
        "dark": "./assets/images/brand/icon-dark.png",
        "tinted": "./assets/images/brand/icon-tinted.png"
      },
      "bundleIdentifier": "com.mlmdev.flownd"
    },
    "android": {
      "package": "com.mlmdev.flownd",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/brand/android-icon-foreground.png",
        "monochromeImage": "./assets/images/brand/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/brand/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Flownd accede alla foto scelta per riconoscere le transazioni. L’immagine non viene conservata.",
          "cameraPermission": "Flownd usa la fotocamera per riconoscere le transazioni da uno scontrino.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F1712",
          "image": "./assets/images/brand/mark-dark.png",
          "imageWidth": 88,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0F1712",
            "image": "./assets/images/brand/mark-dark.png"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Flownd usa Face ID per proteggere l’accesso ai tuoi dati finanziari."
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://de.sentry.io/",
          "organization": "flownd",
          "project": "react-native",
          "note": "Autenticazione per upload source map: variabile SENTRY_AUTH_TOKEN (EAS environment), mai nel repo."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
