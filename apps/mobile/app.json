{
  "expo": {
    "name": "Flownd",
    "slug": "flownd",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "flownd",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.mlmdev.flownd"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F6F8F7",
        "foregroundImage": "./assets/images/android-icon-flownd.png",
        "monochromeImage": "./assets/images/android-icon-flownd.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F1712",
          "image": "./assets/images/f-alpha-splash.png",
          "imageWidth": 88,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0F1712",
            "image": "./assets/images/f-alpha-splash.png"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
