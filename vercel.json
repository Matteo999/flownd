{
  "buildCommand": "npm run build:web",
  "outputDirectory": "apps/web/dist",
  "functions": {
    "api/eb/auto-sync.js": {
      "maxDuration": 300
    },
    "api/transaction-tools.js": {
      "maxDuration": 300
    },
    "api/recurring-payments.js": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/eb/auto-sync",
      "schedule": "17 5 * * *"
    },
    {
      "path": "/api/recurring-payments",
      "schedule": "17 6 * * *"
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
