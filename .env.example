ENABLE_BANKING_APP_ID=aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee
ENABLE_BANKING_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEo...\n-----END RSA PRIVATE KEY-----"
ENABLE_BANKING_REDIRECT_URL=https://api.example.com/api/eb/callback
ENABLE_BANKING_CONSENT_DAYS=180

# Supabase condiviso — app mobile
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_API_URL=

# Supabase condiviso — web app
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=

# Web: abilita le schermate operative solo in un deployment privato.
# In locale sono già disponibili automaticamente con `npm run dev:web`.
VITE_ENABLE_INTERNAL_ROUTES=false

# Solo backend, mai usare prefissi EXPO_PUBLIC_ o VITE_
SUPABASE_SERVICE_ROLE_KEY=

# Solo backend: Money Coach AI. Per i test usa Gemini (quota gratuita soggetta a limiti).
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_COACH_MODEL=

# Alternativa OpenAI: impostare AI_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_COACH_MODEL=gpt-5.6-sol
